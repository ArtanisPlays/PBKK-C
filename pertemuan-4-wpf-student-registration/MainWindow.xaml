<Window x:Class="PBKKC.Pertemuan4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrasi Mahasiswa | PBKK C — Pertemuan 4"
        Width="1200" Height="840" MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F4F7FA"
        Foreground="{StaticResource Ink}" FontFamily="Segoe UI" FontSize="13" Language="id-ID">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PBKK C  /  PERTEMUAN 4" FontSize="11" FontWeight="Bold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,7" />
                <TextBlock Text="Registrasi Mahasiswa" FontSize="30" FontWeight="SemiBold" />
                <TextBlock Text="Daftarkan mahasiswa dan kelola data dalam satu tempat."
                           Foreground="{StaticResource Muted}" Margin="0,6,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Background="#E4F1F3" CornerRadius="8" Padding="18,12"
                    VerticalAlignment="Center" Margin="20,0,0,0">
                <StackPanel>
                    <TextBlock x:Name="TotalCountText" Text="0" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Accent}" />
                    <TextBlock Text="mahasiswa terdaftar" FontSize="11" Foreground="{StaticResource Muted}" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="355" />
                <ColumnDefinition Width="22" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10">
                <Grid Margin="22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="FormHeading" Text="Pendaftaran baru" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="Kolom bertanda * wajib diisi." Foreground="{StaticResource Muted}"
                                   FontSize="12" Margin="0,5,0,20" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,16" Padding="0,0,6,0">
                      <StackPanel>

                        <TextBlock Text="NIM *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NimBox" MaxLength="20" AutomationProperties.Name="NIM" />
                        <TextBlock x:Name="NimHint" Text="Gunakan NIM unik, maksimal 20 digit." FontSize="11"
                                   Foreground="{StaticResource Muted}" Margin="0,5,0,15" TextWrapping="Wrap" />

                        <TextBlock Text="Nama lengkap *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="NameBox" MaxLength="100" Margin="0,0,0,15" AutomationProperties.Name="Nama lengkap" />

                        <TextBlock Text="Program studi *" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="StudyProgramBox" ItemsSource="{Binding StudyPrograms}" Margin="0,0,0,15"
                                  AutomationProperties.Name="Program studi" />

                        <TextBlock Text="Jenis kelamin *" Style="{StaticResource FieldLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <RadioButton x:Name="MaleButton" Content="Laki-laki" GroupName="Gender" />
                            <RadioButton x:Name="FemaleButton" Content="Perempuan" GroupName="Gender" />
                        </StackPanel>

                        <TextBlock Text="Tanggal lahir *" Style="{StaticResource FieldLabel}" />
                        <DatePicker x:Name="BirthDatePicker" SelectedDateFormat="Short" Margin="0,0,0,15"
                                    DateValidationError="BirthDatePicker_DateValidationError"
                                    SelectedDateChanged="BirthDatePicker_SelectedDateChanged"
                                    AutomationProperties.Name="Tanggal lahir" />

                        <TextBlock Text="Email *" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="EmailBox" MaxLength="254" Margin="0,0,0,15" AutomationProperties.Name="Email" />

                        <TextBlock Text="Nomor telepon" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="PhoneBox" MaxLength="30" Margin="0,0,0,15" AutomationProperties.Name="Nomor telepon" />

                        <TextBlock Text="Alamat" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="AddressBox" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap"
                                 Height="72" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                 AutomationProperties.Name="Alamat" />
                      </StackPanel>
                    </ScrollViewer>

                        <Border x:Name="ValidationBanner" Grid.Row="2" Background="#FFF1EE" CornerRadius="6" Padding="12"
                                Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="ValidationText" Foreground="#A33625" TextWrapping="Wrap"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Border>

                    <StackPanel Grid.Row="3">
                        <Button x:Name="SaveButton" Content="Daftarkan mahasiswa" Style="{StaticResource PrimaryButton}"
                                Click="SaveButton_Click" Margin="0,0,0,9" />
                        <Button Content="Form baru / reset" Click="ResetButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="10" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Daftar mahasiswa" FontSize="19" FontWeight="SemiBold" />
                            <TextBlock Text="Pilih baris untuk mengedit data." Foreground="{StaticResource Muted}"
                                       FontSize="12" Margin="0,5,0,0" />
                        </StackPanel>
                        <Button x:Name="DeleteButton" Grid.Column="1" Content="Hapus terpilih" IsEnabled="False"
                                Click="DeleteButton_Click" Foreground="#A33625" Margin="10,0,0,0" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,18">
                        <TextBlock Text="Cari berdasarkan NIM, nama, atau program studi"
                                   Style="{StaticResource FieldLabel}" FontSize="12" />
                        <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged"
                                 AutomationProperties.Name="Cari mahasiswa" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <DataGrid x:Name="StudentsGrid" ItemsSource="{Binding StudentsView}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="StudentsGrid_SelectionChanged"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EAF0F5"
                                  BorderBrush="{StaticResource Line}" BorderThickness="1" RowHeaderWidth="0"
                                  AlternatingRowBackground="#F8FAFC" Background="White"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="Daftar mahasiswa">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="NIM" Binding="{Binding Nim}" Width="125" />
                                <DataGridTextColumn Header="Nama lengkap" Binding="{Binding Name}" Width="*" MinWidth="160" />
                                <DataGridTextColumn Header="Program studi" Binding="{Binding StudyProgram}" Width="155" />
                                <DataGridTextColumn Header="Jenis kelamin" Binding="{Binding Gender}" Width="120" />
                                <DataGridTextColumn Header="Tanggal lahir" Binding="{Binding DateOfBirth, StringFormat={}{0:dd MMM yyyy}}" Width="125" />
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                                <DataGridTextColumn Header="Telepon" Binding="{Binding Phone}" Width="150" />
                                <DataGridTextColumn Header="Alamat" Binding="{Binding Address}" Width="220" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border x:Name="EmptyState" Background="White" Margin="1,47,1,1" IsHitTestVisible="False">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                                <TextBlock x:Name="EmptyHeading" Text="Belum ada mahasiswa" FontSize="18"
                                           FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock x:Name="EmptyDescription" Text="Isi formulir untuk memulai pendaftaran."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="310" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="VisibleCountText" Grid.Row="3" Text="Menampilkan 0 dari 0 mahasiswa"
                               Foreground="{StaticResource Muted}" FontSize="12" Margin="0,14,0,0" />
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Text="Siap menerima pendaftaran." Foreground="{StaticResource Accent}"
                       TextWrapping="Wrap" Margin="0,0,16,0" AutomationProperties.LiveSetting="Polite" />
            <TextBlock Grid.Column="1" Text="Data sementara • hilang saat aplikasi ditutup"
                       FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
